<mxfile host="app.diagrams.net" agent="cursor" version="22.1.0" type="device">
  <diagram id="verification-platform" name="Verification platform">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Verification platform for coding agents — logical plan, not a deployed system" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="frame" value="Security, audit, and trust boundary (not optional): isolate execution, least privilege, secrets, network and file limits, protect contracts and critical tests, trace every edit to an agent, defend against malicious repo instructions, human approval for critical operations, retry and spend limits." style="rounded=0;dashed=1;dashPattern=8 4;strokeColor=#b85450;strokeWidth=2;fillColor=#fff5f5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="2320" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="user" value="User request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="980" y="120" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="planner" value="&lt;b&gt;1. Task planning&lt;/b&gt;&lt;br&gt;Phase 2&lt;br&gt;PERT (O, M, P)&lt;br&gt;Split into checkable subtasks&lt;br&gt;Dependency graph and critical path&lt;br&gt;Uncertainty and scope control&lt;br&gt;Re-estimate with real time&lt;br&gt;Done only with named evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="700" height="180" as="geometry" />
        </mxCell>
        <mxCell id="contracts" value="&lt;b&gt;2. Requirements and contracts&lt;/b&gt;&lt;br&gt;Phase 1&lt;br&gt;Natural language to a frozen YAML contract&lt;br&gt;Ambiguity, contradiction, incompleteness&lt;br&gt;Observable acceptance criteria&lt;br&gt;Human approval for critical or unsafe reads&lt;br&gt;Agent cannot edit the oracle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="210" width="720" height="180" as="geometry" />
        </mxCell>
        <mxCell id="agents" value="&lt;b&gt;3. Coding agents&lt;/b&gt;&lt;br&gt;Phase 1: one agent, file allow-list&lt;br&gt;Codex, Claude Code, Cursor, others&lt;br&gt;Read-only contract in the prompt&lt;br&gt;Limited retries&lt;br&gt;Phase 3 router picks the model&lt;br&gt;Router cannot edit contracts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="210" width="700" height="180" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;4. Deterministic verification&lt;/b&gt;&lt;br&gt;Phase 1: unit, regression, contract checks, critical blocks&lt;br&gt;Later, only with a measured miss: property tests, fuzzing, mutation, concurrency, transactions, formal checks&lt;br&gt;A critical failure blocks. It is not averaged away." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="700" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ast" value="&lt;b&gt;5. AST and code-to-spec&lt;/b&gt;&lt;br&gt;Phase 2&lt;br&gt;Functions, conditions, returns, exceptions&lt;br&gt;Control flow, data flow, call graph&lt;br&gt;Side effects&lt;br&gt;Compare code, contract, and README by structure&lt;br&gt;LLM may explain. It cannot replace line evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="450" width="720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="integ" value="&lt;b&gt;6. Integration search&lt;/b&gt;&lt;br&gt;Phase 2: faults, concurrency, timeouts, duplicates, coverage fuzz, repro, minimize&lt;br&gt;Phase 3: genetic search only if failures per hour beat fuzzing, property tests, and random search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="450" width="700" height="170" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="&lt;b&gt;7. Risk and decision&lt;/b&gt;&lt;br&gt;States in phase 1: PASS, FAIL, UNKNOWN, NOT_APPLICABLE&lt;br&gt;Score in phase 2, weights uncalibrated:&lt;br&gt;R = 0.30C + 0.25I + 0.20S + 0.15U + 0.10H&lt;br&gt;Permission changes and critical security findings force a block at any score&lt;br&gt;UNKNOWN is not a pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="700" height="170" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;Evidence report&lt;/b&gt;&lt;br&gt;Phase 1&lt;br&gt;Reproducible findings, contract revision, file and line refs, limitations&lt;br&gt;A model may explain the report&lt;br&gt;It must not change the stored result&lt;br&gt;CI fails closed on a critical FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="680" width="720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tokens" value="&lt;b&gt;11. Tokens, cost, observability&lt;/b&gt;&lt;br&gt;Phase 2 ledger&lt;br&gt;Input, output, and reported reasoning tokens&lt;br&gt;Cost, latency, calls, retries, tool use, test cost, budgets&lt;br&gt;Defects found per cost&lt;br&gt;&lt;b&gt;Ponyfill and Capy: unidentified. No integration.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="680" width="700" height="170" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;9. Scoring engine&lt;/b&gt;&lt;br&gt;Phase 3&lt;br&gt;Separate metrics: detection, false alarms, contract compliance, integration, evidence, PERT accuracy, cost, regression&lt;br&gt;No blended score that hides a critical hole" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="&lt;b&gt;8. Teacher (professor)&lt;/b&gt;&lt;br&gt;Phase 3&lt;br&gt;Proposes strategy changes from verified results&lt;br&gt;Cannot relabel a failure as a pass&lt;br&gt;Cannot edit contracts&lt;br&gt;Another model's opinion is not a label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="910" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="memory" value="&lt;b&gt;Experience memory&lt;/b&gt;&lt;br&gt;Phase 3&lt;br&gt;Tasks, decisions, defects, fixes&lt;br&gt;Stores verified outcomes&lt;br&gt;Not model confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="910" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rl" value="&lt;b&gt;10. Rules, then bandit or RL&lt;/b&gt;&lt;br&gt;Phase 3&lt;br&gt;Learns model, split size, tests, fuzz, mutation, human review, strategy switch&lt;br&gt;Reward from verified defects, false alarms, time, and cost&lt;br&gt;Must beat a fixed rule strategy&lt;br&gt;Must not edit contracts or lift a critical block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1960" y="910" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="benchmark" value="&lt;b&gt;Benchmark (phase 1 gate)&lt;/b&gt;&lt;br&gt;Defects this gate catches that the agent's own tests pass.&lt;br&gt;Also escape rate, false alarms, cost, requirement coverage.&lt;br&gt;Runner only if the Module A rule is met." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1110" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="commercial" value="&lt;b&gt;Commercial study&lt;/b&gt;&lt;br&gt;Who would pay, and why.&lt;br&gt;Valid only beside the benchmark's extra catches and recorded cost.&lt;br&gt;No billing product in this plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="1110" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Read top to bottom for the first gate. The learning row starts only after the benchmark has a history. Dashed arrows are recommendations, not verdicts. Passing tests are not a proof." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1380" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="user" target="planner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="planner" target="contracts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="contracts" target="agents">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="code, not a verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="agents" target="verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="agents" target="ast">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="integ" target="verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="critical block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;" edge="1" parent="1" source="verify" target="risk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="ast" target="risk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="risk" target="report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="verified results only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;dashed=1;fontSize=11;" edge="1" parent="1" source="report" target="teacher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="report" target="score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="report" target="memory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="cannot edit contracts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;fontSize=11;" edge="1" parent="1" source="rl" target="agents">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="tokens" target="agents">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="frozen contract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="contracts" target="verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="report" target="benchmark">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="benchmark" target="commercial">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
